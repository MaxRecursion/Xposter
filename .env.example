# ─────────────────────────────────────────────
# XPOSTER — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Security ─────────────────────────────────
# Random secret used to authenticate ntfy callback requests.
# Generate with: openssl rand -hex 32
API_KEY=change_me_generate_with_openssl_rand_hex_32

# Trust mutation requests from the dashboard's own LAN/Tailscale origin.
# Keep true for phone use; set false to force API key prompts off-Mac.
TRUST_DASHBOARD_ORIGIN=true



# ── Groq LLM (free tier) ─────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=replace_me_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── ntfy Notifications ───────────────────────
# Choose a hard-to-guess topic name (acts as a shared secret).
# Subscribe to this topic in the ntfy iOS app.
# Example: xposter-akshay-abc123
NTFY_TOPIC=xposter-your-secret-topic
NTFY_SERVER=https://ntfy.sh
# iOS is most reliable with "view" actions because it opens a signed local URL.
# Use "http" for silent background callbacks if your device/network supports it.
NTFY_ACTION_MODE=view

# ── Callback URL (for ntfy action buttons) ───
# This must be reachable from your iPhone.
# On same WiFi: find Mac IP with `ipconfig getifaddr en0`
# Over internet: install Tailscale on Mac + iPhone and set CALLBACK_NETWORK=tailscale
# Explicit override wins over CALLBACK_NETWORK.
CALLBACK_NETWORK=tailscale
CALLBACK_BASE_URL=
TAILSCALE_IP=

# ── Browser ──────────────────────────────────
# Path where Playwright stores browser profile (cookies, session).
BROWSER_USER_DATA_DIR=./browser-profile
# Set to 'true' to see the browser window (useful for debugging)
BROWSER_HEADLESS=true

# ── X Auth Cookies (login bypass) ────────────
# X silently blocks Playwright-driven logins — the username form refuses to
# advance to password. Workaround: log in manually in your REGULAR Chrome,
# then copy the cookies out of DevTools so the bot's browser starts already
# authenticated.
#
# How to get these:
#   1. In your normal Chrome, log in to https://x.com
#   2. Open DevTools (Cmd+Opt+I) → Application tab → Cookies → https://x.com
#   3. Copy the "Value" of the cookie named "auth_token" → X_AUTH_TOKEN
#   4. Copy the "Value" of the cookie named "ct0"        → X_CT0
#   5. Restart the bot
#
# These last ~1 year. Refresh whenever the bot logs "NOT LOGGED IN TO X" again.
X_AUTH_TOKEN=
X_CT0=

# ── Scheduler ────────────────────────────────
# Cron expression for timeline ingestion (default: 5 runs/day local time)
INGEST_CRON=0 9,12,15,18,21 * * *
# Max candidates to process per run (prevents spam)
MAX_CANDIDATES_PER_RUN=3
# Minutes before a PENDING_APPROVAL post auto-expires
APPROVAL_TIMEOUT_MINUTES=30

# ── Filtering ────────────────────────────────
# Comma-separated keywords (English). Marathi equivalents are built-in.
TOPIC_KEYWORDS=pune,rain,traffic,flooding,waterlogging,pothole,local,event
# Minimum relevance score (0-100) to become a candidate
MIN_SCORE=40

# ── Rate Limiting ────────────────────────────
# Minimum seconds between posted replies (safety floor)
MIN_REPLY_INTERVAL_SECONDS=300

# Signed ntfy action URLs expire after this many seconds.
ACTION_TOKEN_TTL_SECONDS=86400

# When unset or any value other than 'false', the system+user prompt sent to
# Groq is printed to stdout (handy for tuning the context block). Set to
# 'false' to silence in production.
LOG_PROMPTS=true

# ── Context / RAG (optional) ─────────────────
# Master switch. Off by default; the rest of the file is unused unless this is true.
CONTEXT_ENABLED=false

# Voyage AI embeddings — get a key at https://dash.voyageai.com
# Free tier covers single-user volume comfortably.
VOYAGE_API_KEY=
# Embedding dimension — voyage-3-lite supports 256/512/1024. 512 is a good default.
# Changing this requires deleting the vec_context table (or starting a new DB).
VOYAGE_DIM=512

# Per-source poll interval in minutes (overrides each source's default).
# Leave blank to use defaults (30 min).
CONTEXT_INGEST_INTERVAL_MIN=

# Voyage requests-per-minute cap. Free tier without payment method = 3 RPM.
# Default of 2.7 keeps us safely under that. Bump if you've enabled paid tier.
VOYAGE_RPM=2.7

# RSS feeds. Set any URL to "" (empty) to disable that source.
# - Loksatta dropped public RSS; default is blank. Override if you find a working URL.
# - Indian Express Pune section feed is the most reliable English source.
# - eSakal's public RSS exists but is paywall-empty; default blank.
CONTEXT_RSS_LOKSATTA_PUNE=
CONTEXT_RSS_IE_PUNE=https://indianexpress.com/section/cities/pune/feed/
CONTEXT_RSS_HT_PUNE=https://www.hindustantimes.com/feeds/rss/cities/pune-news/rssfeed.xml
CONTEXT_RSS_ESAKAL_PUNE=
CONTEXT_RSS_IE_AI=https://indianexpress.com/section/technology/artificial-intelligence/feed/
CONTEXT_RSS_IE_ECONOMY=https://indianexpress.com/section/business/economy/feed/
CONTEXT_RSS_IE_JOBS=https://indianexpress.com/section/jobs/feed/
CONTEXT_RSS_IE_WORKPLACE=https://indianexpress.com/section/lifestyle/workplace/feed/
CONTEXT_RSS_MINT_AI=https://www.livemint.com/rss/AI
CONTEXT_RSS_MINT_INDUSTRY=https://www.livemint.com/rss/industry
CONTEXT_RSS_RBI_PRESS=https://rbi.org.in/pressreleases_rss.xml
CONTEXT_RSS_INC42=https://inc42.com/feed/
CONTEXT_RSS_INC42_AI_SHIFT=https://inc42.com/tag/the-ai-shift/feed/
CONTEXT_RSS_INC42_STARTUPS=https://inc42.com/startups/feed/
CONTEXT_RSS_YOURSTORY=https://yourstory.com/feed

# Reddit subreddits (no auth needed). Set to "" to disable.
CONTEXT_REDDIT_PUNE=pune
CONTEXT_REDDIT_INDIA=india

# Weather location (passed to wttr.in, no key needed). Set to "" to disable.
CONTEXT_WEATHER_PUNE=Pune

# ── Claude Agent SDK (optional code-maintainer agent) ─────────────────
# Off by default — toggle from the dashboard Settings tab.
# Requires: Claude Code installed (`claude` on PATH) + `gh` for PRs.
# This env var is an INFRASTRUCTURE-level kill switch. When 'false',
# the whole subsystem is inert regardless of the in-dashboard toggle.
AGENT_ENABLED=true

# Model used for both investigator (read-only) and implementer (writes) runs.
AGENT_MODEL=claude-sonnet-4-5

# Hard cap on agent runs per day across both modes (cost guard).
AGENT_MAX_RUNS_PER_DAY=10

# Max turns per run (additional cost guard).
AGENT_INVESTIGATOR_MAX_TURNS=30
AGENT_IMPLEMENTER_MAX_TURNS=60

# Watcher poll interval in milliseconds (default 5 minutes; min 30s).
AGENT_WATCH_INTERVAL_MS=300000

# Paths the agent must never read or write. Always appended to defaults
# (.env, data/, browser-profile/, logs/). Comma-separated relative paths.
AGENT_DISALLOWED_PATHS=

# Allow the implementer to use WebFetch / WebSearch for docs lookups.
AGENT_ALLOW_WEB=false

# Base branch the implementer worktree is forked from.
AGENT_BASE_BRANCH=main

# ── Agentic content generation (Claude Agent SDK loop) ────────────────
# Off by default — toggle the `agentic_generation` setting from the
# dashboard settings API:
#   PATCH /api/posts/settings/update  {"agentic_generation": "true"}
# When on, replies and original posts are produced by an agent that can
# search the local news index, run live X searches, read pages, and must
# pass a validator before its text is accepted. Falls back to the
# single-shot Claude/Groq path on any failure.
# Auth: uses ANTHROPIC_API_KEY if set, otherwise the local `claude` CLI
# login (same as the maintainer agent).

# Model for the generation agent. Defaults to CLAUDE_GENERATOR_MODEL
# (claude-opus-4-8 if that is unset too).
AGENTIC_GENERATOR_MODEL=

# Max agent turns per generation (cost guard).
AGENTIC_GEN_MAX_TURNS=12

# ── Image generation ────────────────────────────────────────────────
# Provider chain, best first: gemini -> openai -> huggingface -> pollinations.
# Each is skipped unless its key is present, and paid ones are also skipped
# once the monthly budget is spent — so an exhausted budget degrades to the
# free provider instead of halting image posts.
# Set this to one of those names to try it first.
#
# NOTE: Pollinations' anonymous tier serves ONE model, `sana`. Asking it for
# `flux` or `turbo` returns a SANA image anyway, so those are not real
# fallbacks and are no longer requested. Its reference-image models
# (kontext, nanobanana) are paid-tier only.
IMAGE_PROVIDER=

# Google AI Studio key — enables Gemini image generation, the only provider
# here that accepts reference images. Get one at aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-3.1-flash-image  $0.067/1K image, up to 4 reference images  (default)
# gemini-3-pro-image      $0.134/1K image, up to 5 reference images
# gemini-3.1-flash-lite-image is CHEAPER but supports NO reference images.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 512px | 1K | 2K | 4K  (uppercase K required by the API)
GEMINI_IMAGE_SIZE=1K

# OpenAI key, used for DALL-E 3 image generation.
OPENAI_API_KEY=

# Optional. Free Hugging Face Inference API token — a genuinely different
# backend (black-forest-labs/FLUX.1-schnell) used if Pollinations fails.
# Get one at hf.co/settings/tokens.
HF_API_KEY=

# Image geometry. 4:5 portrait is X's tallest un-cropped feed aspect.
# 640x800 = 512k pixels, which sits under Pollinations' ~590k budget and so
# comes back at exactly this size; larger requests are silently downscaled.
IMAGE_WIDTH=640
IMAGE_HEIGHT=800

# Overrides the built-in visual identity with a single free-text subject
# description. The persona is faceless by design — continuity comes from hair,
# wardrobe, props and film grade, not a face. For finer control set the
# `image_identity_json` DB setting instead.
IMAGE_CHARACTER_PROMPT=

# Model used by the vision QA gate that checks generated images for a visible
# face, malformed hands or garbled text. Runs through the local `claude` CLI on
# the Pro/Max subscription, so it costs nothing per call.
IMAGE_QA_MODEL=fable

# ── Trending topic replies ──────────────────────────────────────────
# Infrastructure kill switch for X trend polling. Set to "false" to stop
# fetching trends entirely; day-to-day control is the `trend_replies_enabled`
# setting in the dashboard.
X_TRENDS_ENABLED=true
