<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WasmNativePin</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Shared .NET + DuckDB linear memory; leave headroom for 1M-row working set -->
    <EmccMaximumHeapSize>1610612736</EmccMaximumHeapSize>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Benchmark.Core\Benchmark.Core.csproj" />
  </ItemGroup>

  <!-- Single relocatable object (whole-archive of DuckDB) so wasm-ld keeps all members.
       FileName must be duckdb_native so it matches DllImport("duckdb_native"). -->
  <ItemGroup>
    <NativeFileReference Include="Native\duckdb_native.o" Condition="Exists('Native\duckdb_native.o')" />
  </ItemGroup>

  <Target Name="EnsureNativeDuckDb" BeforeTargets="ResolveWasmProjectReference;NativeBuild;WasmBuildApp" Condition="!Exists('Native\duckdb_native.o')">
    <Warning Text="Native\duckdb_native.o missing. Run: apps/WasmNativePin/native-src/build-native.sh" />
  </Target>

</Project>
