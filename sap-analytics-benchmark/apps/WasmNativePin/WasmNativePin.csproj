<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WasmNativePin</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Shared .NET + DuckDB linear memory; leave headroom for 1M-row working set -->
    <EmccMaximumHeapSize>1610612736</EmccMaximumHeapSize>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Benchmark.Core\Benchmark.Core.csproj" />
  </ItemGroup>

  <!-- DuckDB amalgamation + C bridge built with matching Emscripten 3.1.56 (see native-src/build-native.sh) -->
  <ItemGroup>
    <NativeFileReference Include="Native\libduckdb_native.a" Condition="Exists('Native\libduckdb_native.a')" />
  </ItemGroup>

  <Target Name="EnsureNativeDuckDb" BeforeTargets="ResolveWasmProjectReference;NativeBuild;WasmBuildApp" Condition="!Exists('Native\libduckdb_native.a')">
    <Warning Text="Native\libduckdb_native.a missing. Run: apps/WasmNativePin/native-src/build-native.sh" />
  </Target>

</Project>
