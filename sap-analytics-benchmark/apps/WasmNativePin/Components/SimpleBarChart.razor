@inject IJSRuntime JS

<div class="chart-host">
    <canvas @ref="_canvas" width="640" height="240"></canvas>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter] public IReadOnlyList<double> Values { get; set; } = [];

    private ElementReference _canvas;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Labels.Count > 0 && Values.Count > 0)
        {
            await JS.InvokeVoidAsync("BenchmarkBridge.renderBarChart", _canvas, Labels.ToArray(), Values.ToArray());
        }
    }
}
